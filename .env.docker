# 应用配置
APP_NAME="Renhotec Academy"
APP_ENV=production
APP_DEBUG=false
APP_PORT=9000
APP_URL=https://learn.renhotec.cn
FRONTEND_URL=https://learn.renhotec.cn

# 数据库配置
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=renhotec_academy
DB_USERNAME=renhotec
DB_PASSWORD=renhotec123

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6479
REDIS_PASSWORD=renhotec123

# Sanctum 配置
SANCTUM_STATEFUL_DOMAINS=learn.renhotec.cn

# 阿里云 OSS 配置
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
OSS_ENDPOINT=""
OSS_CDN_DOMAIN=""
OSS_SSL=true
OSS_IS_CNAME=false
OSS_DEBUG=false
OSS_IS_PRIVATE=true
OSS_SIGNED_URL_EXPIRES=3600

# OSS 路径前缀（根据环境自动切换）
OSS_PREFIX=academy/prod

# 文件系统配置
FILESYSTEM_DISK=oss
